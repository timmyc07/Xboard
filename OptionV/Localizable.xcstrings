{
  "sourceLanguage": "en",
  "strings": {
    "Hotkeys": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷鍵"
          }
        }
      }
    },
    "Open history": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟剪貼簿紀錄"
          }
        }
      }
    },
    "Record GIF": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製 GIF"
          }
        }
      }
    },
    "Start Clipboard Stack": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始連續複製"
          }
        }
      }
    },
    "Paste Next Stack Item": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上下一筆"
          }
        }
      }
    },
    "History": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄"
          }
        }
      }
    },
    "Recent unpinned items": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留未釘選筆數"
          }
        }
      }
    },
    "History limit": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄筆數"
          }
        }
      }
    },
    "Choose any count of 10 or more. Pinned items do not count toward this limit. Large image histories use more memory and disk space.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可自行設定 10 筆以上；釘選項目不計入上限。大量圖片紀錄會使用較多記憶體與磁碟空間。"
          }
        }
      }
    },
    "Clear history": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清空紀錄"
          }
        }
      }
    },
    "Clear unpinned": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除未釘選項目"
          }
        }
      }
    },
    "Retention": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動清除期限"
          }
        }
      }
    },
    "Unpinned items older than this are removed automatically. Pinned items are kept.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過期限的未釘選項目會自動清除，釘選項目會保留。"
          }
        }
      }
    },
    "Privacy": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱私"
          }
        }
      }
    },
    "History paused": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停紀錄"
          }
        }
      }
    },
    "History capture": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄剪貼簿"
          }
        }
      }
    },
    "Resume": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續"
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停"
          }
        }
      }
    },
    "Ignore applications": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排除應用程式"
          }
        }
      }
    },
    "No other running applications found.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到其他執行中的應用程式。"
          }
        }
      }
    },
    "Copies made while an ignored application is active are not stored.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在排除的應用程式中複製時，不會儲存內容。"
          }
        }
      }
    },
    "Local security": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機安全"
          }
        }
      }
    },
    "Encrypted storage": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加密儲存"
          }
        }
      }
    },
    "Active": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用"
          }
        }
      }
    },
    "History and Library files are encrypted with AES-GCM. The key is stored in this Mac's Keychain and is not synced or uploaded.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄與常用文字以 AES-GCM 加密；金鑰保存在此 Mac 的鑰匙圈，不會同步或上傳。"
          }
        }
      }
    },
    "Protect History and Library": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護紀錄與常用文字"
          }
        }
      }
    },
    "Require Touch ID or the Mac password each time either private view is opened.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次開啟紀錄或常用文字時，都需要 Touch ID 或 Mac 密碼。"
          }
        }
      }
    },
    "Clipboard capture continues in the background.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景仍會繼續記錄剪貼簿。"
          }
        }
      }
    },
    "Device authentication is unavailable on this Mac.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 無法使用裝置驗證。"
          }
        }
      }
    },
    "Startup": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時啟動"
          }
        }
      }
    },
    "Start OptionV automatically after you sign in.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後自動啟動 OptionV。"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外觀"
          }
        }
      }
    },
    "Color scheme": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顏色主題"
          }
        }
      }
    },
    "Material": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景樣式"
          }
        }
      }
    },
    "Liquid Glass uses the native glass surface on macOS 26 or later and a material fallback on earlier versions.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 26 以上使用原生液態玻璃；較早版本使用標準半透明背景。"
          }
        }
      }
    },
    "Automatic paste": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動貼上"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用"
          }
        }
      }
    },
    "Required": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授權"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟系統設定"
          }
        }
      }
    },
    "Grant access to paste into the previous app automatically. History and manual paste work without it.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權後可自動貼回原本的應用程式。未授權仍可使用紀錄與手動貼上。"
          }
        }
      }
    },
    "Clear history?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要清空所有紀錄嗎？"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Removes text, images, and references stored by the app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除本程式儲存的文字、圖片與檔案參照。"
          }
        }
      }
    },
    "Clear unpinned history?": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除未釘選的紀錄嗎？"
          }
        }
      }
    },
    "Pinned items and original files remain untouched.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釘選項目與原始檔案會保留。"
          }
        }
      }
    },
    "Press a new combination…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請按下新的快捷鍵…"
          }
        }
      }
    },
    "Not set": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定"
          }
        }
      }
    },
    "Change": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改"
          }
        }
      }
    },
    "Set": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "Your clipboard history, free and stored only on this Mac.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費的剪貼簿紀錄，內容只保存在這台 Mac。"
          }
        }
      }
    },
    "Select an item to paste. Without Accessibility permission, select it and press ⌘V in the destination app.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取項目即可貼上。未授權輔助使用時，選取後請在目標程式按 ⌘V。"
          }
        }
      }
    },
    "Allow clipboard access when macOS asks so OptionV can save your copied items.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 詢問時，請允許剪貼簿存取，以便 OptionV 儲存複製內容。"
          }
        }
      }
    },
    "Option-based shortcuts may be blocked in password fields. Change the shortcut if it conflicts with your input method.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Option 快捷鍵可能在密碼欄位中被系統阻擋；若與輸入法衝突，可在這裡更改。"
          }
        }
      }
    },
    "Ignore Next Copy": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "略過下一次複製"
          }
        }
      }
    },
    "Resume History": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續記錄"
          }
        }
      }
    },
    "Pause History": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停記錄"
          }
        }
      }
    },
    "More tools": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更多工具"
          }
        }
      }
    },
    "Library…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常用文字…"
          }
        }
      }
    },
    "Capture and Annotate…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "截圖與標註…"
          }
        }
      }
    },
    "Stop GIF Recording": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止錄製 GIF"
          }
        }
      }
    },
    "Cancel GIF Recording": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消錄製 GIF"
          }
        }
      }
    },
    "Record GIF…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製 GIF…"
          }
        }
      }
    },
    "Save Latest GIF…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另存最近的 GIF…"
          }
        }
      }
    },
    "Cancel Stack Capture": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消連續複製"
          }
        }
      }
    },
    "Clear Clipboard Stack": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清空連續複製佇列"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定…"
          }
        }
      }
    },
    "Quit OptionV": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束 OptionV"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨系統"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淺色"
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深色"
          }
        }
      }
    },
    "Liquid Glass": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "液態玻璃"
          }
        }
      }
    },
    "Standard": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標準"
          }
        }
      }
    },
    "Hotkeys must be different.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷鍵不能重複。"
          }
        }
      }
    },
    "Hotkey unavailable; previous configuration kept.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷鍵無法使用，已保留原本設定。"
          }
        }
      }
    },
    "GIF hotkey unavailable; previous configuration kept.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GIF 快捷鍵無法使用，已保留原本設定。"
          }
        }
      }
    },
    "That hotkey is already in use.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此快捷鍵已被使用。"
          }
        }
      }
    },
    "Launch at login could not be changed.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更改登入時啟動設定。"
          }
        }
      }
    },
    "Open clipboard history": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟剪貼簿紀錄"
          }
        }
      }
    },
    "This item cannot be edited.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法編輯此項目。"
          }
        }
      }
    },
    "Text extraction is available for static images only.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅靜態圖片可擷取文字。"
          }
        }
      }
    },
    "Extracting text…": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在擷取文字…"
          }
        }
      }
    },
    "No text was detected in the image.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未在圖片中找到文字。"
          }
        }
      }
    },
    "The extracted text could not be copied.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法複製擷取的文字。"
          }
        }
      }
    },
    "Extracted text copied to the clipboard.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已複製擷取的文字。"
          }
        }
      }
    },
    "No preview is available for this item.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法預覽此項目。"
          }
        }
      }
    },
    "Item deleted.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除項目。"
          }
        }
      }
    },
    "Only text items can be saved to the Library.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅文字可存入常用文字。"
          }
        }
      }
    },
    "Saved to Library.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已存入常用文字。"
          }
        }
      }
    },
    "Open the clipboard Library": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟常用文字"
          }
        }
      }
    },
    "Library — OptionV": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "常用文字 — OptionV"
          }
        }
      }
    },
    "History and Library authentication disabled.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停用紀錄與常用文字驗證。"
          }
        }
      }
    },
    "Touch ID or Mac authentication is unavailable.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用 Touch ID 或 Mac 密碼驗證。"
          }
        }
      }
    },
    "Protect clipboard history and Library": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護剪貼簿紀錄與常用文字"
          }
        }
      }
    },
    "History and Library authentication enabled.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用紀錄與常用文字驗證。"
          }
